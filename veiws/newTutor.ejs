<!DOCTYPE html>
<html>
<head>
  <title>Become a Tutor</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="navbar">
  <div class="logo">PeerTutor</div>
</div>

<div class="form-box">
  <h1>Join PeerTutor</h1>

  <form action="/tutors" method="POST">
    <input class="input-field" name="name" placeholder="Full Name" required>
    <input class="input-field" name="email" placeholder="School Email" required>
    <input class="input-field" name="subject" placeholder="Subject" required>
    <input class="input-field" name="grade" placeholder="Grade Level" required>
    <input class="input-field" name="availability" placeholder="Availability" required>
    <input class="input-field" name="bio" placeholder="Short Bio" required>

    <button class="submit-btn" type="submit">
      Submit
    </button>
  </form>
</div>

<div class="footer">
  © 2026 PeerTutor
</div>

</body>
</html>