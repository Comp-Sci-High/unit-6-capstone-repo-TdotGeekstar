<!DOCTYPE html>
<html>
<head>
  <title>Login</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="navbar">
    <div class="logo">Comp Sci High PeerTutor</div>
  </div>

  <div class="form-box">
    <h1>Login</h1>
    <p class="subtitle">
      Sign in with your Comp Sci High account
    </p>

    <form action="/login" method="POST">

      <input
        class="input-field"
        type="text"
        name="username"
        placeholder="Username"
        required
      >

      <input
        class="input-field"
        type="password"
        name="password"
        placeholder="Password"
        required
      >

      <button
        class="submit-btn"
        type="submit"
      >
        Login
      </button>

    </form>

    <p style="text-align:center; margin-top:20px;">
      Need an account?
      <a href="/register">Register here</a>
    </p>
  </div>

</body>
</html>