<!DOCTYPE html>
<html>
<head>
  <title>Register</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="form-box">
  <h1>Create Account</h1>

  <form action="/register" method="POST">

    <input
      class="input-field"
      name="username"
      required
      placeholder="Username"
    >

    <input
      class="input-field"
      name="email"
      required
      placeholder="Comp Sci High Email"
    >

    <input
      class="input-field"
      type="password"
      name="password"
      required
      placeholder="Password"
    >

    <button
      class="submit-btn"
      type="submit"
    >
      Register
    </button>

  </form>
</div>

</body>
</html>