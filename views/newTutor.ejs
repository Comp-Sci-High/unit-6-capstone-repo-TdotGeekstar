<!DOCTYPE html>
<html>
<head>
  <title>Create Session</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="form-box">
  <h1>Create Tutoring Session</h1>

  <form action="/tutors" method="POST">

    <input
      class="input-field"
      name="name"
      placeholder="Session Name"
      required
    >

    <select
      class="input-field"
      name="department"
      required
    >
      <option>English Department</option>
      <option>Math Department</option>
      <option>Science Department</option>
      <option>History Department</option>
      <option>Computer Science Department</option>
    </select>

    <input
      class="input-field"
      name="subject"
      placeholder="Subject"
      required
    >

    <input
      class="input-field"
      name="bio"
      placeholder="Description"
      required
    >

    <input
      class="input-field"
      type="date"
      name="sessionDate"
      required
    >

    <input
      class="input-field"
      type="time"
      name="sessionTime"
      required
    >

    <input
      class="input-field"
      type="number"
      name="maxStudents"
      min="1"
      required
    >

    <button
      class="submit-btn"
      type="submit"
    >
      Create Session
    </button>

  </form>
</div>

</body>
</html>